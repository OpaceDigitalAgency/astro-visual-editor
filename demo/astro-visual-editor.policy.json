      "effect": "deny",
      "scope": "element",
      "route": "/",
      "selector": "[data-demo-banner]"
    },
    {
      "id": "lock-simple-review-section",
      "effect": "deny",
      "scope": "element",
      "route": "/",
      "selector": "[data-section=\"review\"]"
    },
    {
      "id": "lock-complex-client",
      "effect": "deny",
      "scope": "element",
      "route": "/fixtures/complex",
