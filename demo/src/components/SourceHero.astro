---
interface Props {
  eyebrow: string;
  title: string;
  summary: string;
  action: string;
}

const { eyebrow, title, summary, action } = Astro.props;
const source = 'src/data/complex-page.json';
---

<section
  class="hero"
  aria-labelledby="complex-title"
  data-astro-edit-region="complex-hero-blocks"
  data-astro-edit-file="src/components/SourceHero.astro"
  data-astro-edit-label="Hero content"
>
  <p
    class="eyebrow"
    data-section="hero-eyebrow"
    data-astro-edit-label="Eyebrow"
    data-astro-edit-file={source}
    data-astro-edit-path="hero.eyebrow"
    data-astro-edit-origin="a direct JSON import"
  >
    {eyebrow}
  </p>
  <h1
    id="complex-title"
    data-section="hero-heading"
    data-astro-edit-label="Heading"
    data-demo-json-title
    data-astro-edit-file={source}
    data-astro-edit-path="hero.title"
    data-astro-edit-origin="a direct JSON import"
    data-astro-edit-shared-routes="/,/fixtures/complex"
  >
    {title}
  </h1>
  <p
    class="summary"
    data-section="hero-summary"
    data-astro-edit-label="Summary"
    data-astro-edit-file={source}
    data-astro-edit-path="hero.summary"
    data-astro-edit-origin="a direct JSON import"
  >
    {summary}
  </p>
  <button
    type="button"
    data-section="hero-action"
    data-astro-edit-label="Primary action"
    data-astro-edit-file={source}
    data-astro-edit-path="hero.action"
    data-astro-edit-origin="a direct JSON import"
  >
    <span>{action}</span>
  </button>
</section>

<style>
  .hero {
    padding: clamp(36px, 8vw, 86px) 0 48px;
    border-bottom: 1px solid #30353a;
  }
  .eyebrow {
    margin: 0;
    color: #ff9f69;
    font:
      800 12px/1.2 ui-monospace,
      monospace;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  h1 {
    max-width: 920px;
    margin: 16px 0;
    font-size: clamp(3rem, 8vw, 6.8rem);
    line-height: 0.92;
    letter-spacing: -0.07em;
  }
  .summary {
    max-width: 720px;
    color: #b8bec4;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }
  button {
    min-height: 44px;
    padding: 10px 15px;
    color: #17191b;
    background: #ff8a4c;
    border: 1px solid #ffad82;
    border-radius: 9px;
    font-weight: 800;
  }
</style>
