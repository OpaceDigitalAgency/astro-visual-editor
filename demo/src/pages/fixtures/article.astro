---
const heading = 'Fixture article heading';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <title>Article fixture</title>
  </head>
  <body>
    <main>
      <article>
        <h1 data-astro-edit-file="src/pages/fixtures/article.astro">{heading}</h1>
        <p data-astro-edit-file="src/pages/fixtures/article.astro">
          This sentence is unique and safely editable.
        </p>
        <p data-astro-edit-ignore>This sentence is intentionally excluded.</p>
        <p>This source needs owner confirmation.</p>
        <p>Nested <strong>formatting must stay structurally safe.</strong></p>
      </article>
    </main>
  </body>
</html>
