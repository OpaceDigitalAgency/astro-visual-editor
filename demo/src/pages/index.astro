---
const title = 'Edit Astro where you can see it';
---

<!doctype html>
<html
  lang="en"
  data-astro-edit-file="src/pages/index.astro"
  data-astro-edit-seo-file="src/pages/index.astro"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Astro Visual Editor integration demo" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <title>Astro Visual Editor demo</title>
    <style>
      :root {
        color-scheme: dark;
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
      }

      body {
        min-height: 100vh;
        margin: 0;
        color: #f8f5f1;
        background: #101214;
      }

      main {
        width: min(1040px, calc(100% - 40px));
        margin: 0 auto;
        padding: 96px 0;
      }

      .tag {
        color: #ff8a4c;
        font:
          700 12px/1.2 ui-monospace,
          monospace;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 820px;
        margin: 18px 0;
        font-size: clamp(3rem, 8vw, 7rem);
        line-height: 0.92;
        letter-spacing: -0.07em;
      }

      .lead {
        max-width: 650px;
        color: #b8bec4;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
        line-height: 1.65;
      }

      .grid {
        display: grid;
        margin-top: 56px;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
      }

      .card {
        min-height: 190px;
        padding: 24px;
        background: #191c1f;
        border: 1px solid #30353a;
        border-radius: 14px;
      }

      .card strong {
        display: block;
        margin-bottom: 8px;
        color: #ff9f69;
        font:
          700 12px/1.2 ui-monospace,
          monospace;
      }

      .card p {
        margin: 0;
        color: #d2d6da;
        line-height: 1.6;
      }

      .ave-hero,
      .ave-features,
      .ave-text {
        padding: 28px;
        grid-column: 1 / -1;
        background: #191c1f;
        border: 1px solid #ff8a4c;
        border-radius: 14px;
      }

      .ave-feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
      }

      @media (max-width: 720px) {
        main {
          padding-top: 64px;
        }

        .grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <p class="tag" data-demo-banner data-astro-editable>Development-only source workbench</p>
      <h1 data-astro-edit-id="hero-title">{title}</h1>
      <p class="lead" data-astro-edit-id="hero-lead">
        Click rendered text, preview the result, and commit a reviewed batch directly to your Astro
        source files.
      </p>
      <div
        class="grid"
        aria-label="Editor principles"
        data-astro-edit-region="home-principles"
        data-astro-edit-label="Editor principles"
      >
        <section class="card" data-section="preview" data-astro-edit-label="Preview">
          <strong>01 / PREVIEW</strong>
          <p>Every edit appears in the browser before the source file changes.</p>
        </section>
        <section class="card" data-section="review" data-astro-edit-label="Review">
          <strong>02 / REVIEW</strong>
          <p>A visible ledger shows the old text, new text and expected file.</p>
        </section>
        <section class="card" data-section="commit" data-astro-edit-label="Commit">
          <strong data-astro-edit-ignore>03 / COMMIT</strong>
          <p>One deliberate action writes an all-or-nothing batch to disk.</p>
        </section>
      </div>
    </main>
  </body>
</html>
