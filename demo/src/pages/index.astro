---
const title = 'Edit Astro where you can see it';
---

<!doctype html>
<html lang="en" data-astro-edit-file="src/pages/index.astro" data-astro-edit-seo-file="src/pages/index.astro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Astro Visual Editor integration demo" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2214%22 fill=%22%23ff8a4c%22/><path d=%22M18 45l5-14L43 11l10 10-20 20z%22 fill=%22%23101214%22/></svg>" />
    <title>Astro Visual Editor demo</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
      body { min-height: 100vh; margin: 0; color: #f8f5f1; background: #101214; }
      main { width: min(1040px, calc(100% - 40px)); margin: 0 auto; padding: 96px 0; }
      .tag { color: #ff8a4c; font: 700 12px/1.2 ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase; }
      h1 { max-width: 820px; margin: 18px 0; font-size: clamp(3rem, 8vw, 7rem); line-height: .92; letter-spacing: -.07em; }
      .lead { max-width: 650px; color: #b8bec4; font-size: clamp(1.1rem, 2vw, 1.35rem); line-height: 1.65; }
      .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 56px; }
      .card { min-height: 190px; padding: 24px; background: #191c1f; border: 1px solid #30353a; border-radius: 14px; }
      .card strong { display: block; margin-bottom: 8px; color: #ff9f69; font: 700 12px/1.2 ui-monospace, monospace; }
      .card p { margin: 0; color: #d2d6da; line-height: 1.6; }
      .ave-hero, .ave-features, .ave-text { grid-column: 1 / -1; padding: 28px; background: #191c1f; border: 1px solid #ff8a4c; border-radius: 14px; }
      .ave-feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
      @media (max-width: 720px) { main { padding-top: 64px; } .grid { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <main>
      <p class="tag" data-demo-banner data-astro-editable>Development-only source workbench</p>
      <h1 data-astro-edit-id="hero-title">{title}</h1>
      <p class="lead" data-astro-edit-id="hero-lead">
        Click rendered text, preview the result, and commit a reviewed batch directly to your Astro source files.
      </p>
      <div class="grid" aria-label="Editor principles" data-astro-edit-region="home-principles">
        <section class="card" data-section="preview">
          <strong>01 / PREVIEW</strong>
          <p>Every edit appears in the browser before the source file changes.</p>
        </section>
        <section class="card" data-section="review">
          <strong>02 / REVIEW</strong>
          <p>A visible ledger shows the old text, new text and expected file.</p>
        </section>
        <section class="card" data-section="commit">
          <strong>03 / COMMIT</strong>
          <p>One deliberate action writes an all-or-nothing batch to disk.</p>
        </section>
      </div>
    </main>
  </body>
</html>
