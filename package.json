{
  "name": "astro-visual-editor-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "build": "npm run build --workspace astro-visual-editor",
    "check": "npm run check --workspace astro-visual-editor && npm run check --workspace astro-visual-editor-demo",
    "dev": "npm run dev --workspace astro-visual-editor-demo",
    "pack:check": "npm pack --workspace astro-visual-editor --dry-run",
    "test": "npm run test --workspace astro-visual-editor",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm run test && npm run check && npm run pack:check && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.54.2"
  }
}
