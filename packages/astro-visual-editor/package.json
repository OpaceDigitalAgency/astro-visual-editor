{
  "name": "astro-visual-editor",
  "version": "0.1.0",
  "description": "A development-only visual editor for Astro with click-to-edit content, a reviewable change queue, and safe source-file writes.",
  "type": "module",
  "license": "MIT",
  "author": "Opace Digital Agency",
  "homepage": "https://github.com/OpaceDigitalAgency/astro-visual-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpaceDigitalAgency/astro-visual-editor.git"
  },
  "bugs": {
    "url": "https://github.com/OpaceDigitalAgency/astro-visual-editor/issues"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "devtools",
    "dev-toolbar",
    "dev-overlay",
    "visual-editor",
    "content-editing",
    "static-site-editing",
    "tooling",
    "ui"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "astro": ">=7.1.6 <8.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "astro": "^7.1.6",
    "esbuild": "^0.28.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
